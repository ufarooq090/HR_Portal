<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>793a3cd2-52d7-4486-9698-e99fde494674</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageReference Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.0" />
  </ItemGroup>

  <!--
    Security pin: Microsoft.Identity.Web brings in System.Security.Cryptography.Pkcs 10.0.10, vulnerable to
    GHSA-846f-f764-76mx (CVE-2026-84008) and GHSA-2fmv-rv2c-59x7 (CVE-2026-70162). Remove the pin once
    Microsoft.Identity.Web depends on 10.0.13 or later. (System.Security.Cryptography.Xml is pinned in the test
    projects; here the ASP.NET Core framework already supplies a patched copy.)
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HrPortal.Domain\HrPortal.Domain.csproj" />
    <ProjectReference Include="..\HrPortal.Infrastructure\HrPortal.Infrastructure.csproj" />
  </ItemGroup>

</Project>
