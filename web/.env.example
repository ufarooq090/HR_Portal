# Copy to .env.local (git-ignored) to override. None of these values are secrets.

# "dev" = DevAuth user picker (default for `npm run dev`), "entra" = Microsoft Entra ID (default for builds)
VITE_AUTH_MODE=dev

# Entra ID (SPA app registration) — required when VITE_AUTH_MODE=entra
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=api://<api-client-id>/access_as_user

# Where the Vite dev server proxies /api: set HRPORTAL_API_URL as a shell environment variable
# (vite.config.ts reads process.env; it is not loaded from this file). Default: http://localhost:5195
