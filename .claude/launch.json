{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/HrPortal.Api", "--launch-profile", "http"],
      "port": 5195
    },
    {
      "name": "api-no-db",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/HrPortal.Api", "--launch-profile", "http", "--", "--Database:MigrateOnStartup=false"],
      "port": 5195
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173
    }
  ]
}
